{
  "name": "openchat-webmcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "guard": "npm run guard:boundaries && npm run guard:clean-code",
    "guard:boundaries": "depcruise src --config .dependency-cruiser.cjs && node scripts/guard-boundaries.mjs",
    "guard:clean-code": "node scripts/guard-clean-code.mjs",
    "demo": "vite --config demo/vite.config.ts",
    "launch": "node scripts/launch-chrome.mjs",
    "verify": "node verify/run.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@mcp-b/webmcp-types": "^4.0.0",
    "@puppeteer/browsers": "^3.2.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.6",
    "@tsconfig/svelte": "^5.0.8",
    "@types/chrome": "^0.2.6",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.2.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "shadcn-svelte": "^1.5.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.11"
  },
  "description": "Chrome MV3 extension: chat with a local Ollama server or an OpenAI-compatible provider that drives the page via WebMCP tools",
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/svelte": "^1.1.5",
    "@internationalized/date": "^3.12.3",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "marked": "^18.0.10",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1"
  }
}
