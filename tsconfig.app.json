{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "module": "esnext",
    // "@testing-library/jest-dom/vitest" (card 82) is the ambient module
    // augmentation that adds jest-dom's DOM matchers (toBeInTheDocument, ...)
    // to Vitest's `expect` — vitest.setup.ts imports it for the RUNTIME
    // registration (every component test needs that, once, via
    // `test.setupFiles`), but a type program only sees an ambient
    // augmentation if something in ITS OWN program pulls the declaration in,
    // and vitest.setup.ts lives outside src/ (tsconfig.app.json's own
    // include), so it's named here too for the type side.
    "types": ["svelte", "vite/client", "chrome", "@testing-library/jest-dom/vitest"],
    "allowArbitraryExtensions": true,
    "noEmit": true,
    /**
     * Typecheck JS in `.svelte` and `.js` files by default.
     * Disable checkJs if you'd like to use dynamic types in JS.
     * Note that setting allowJs false does not prevent the use
     * of JS in `.svelte` files.
     */
    "allowJs": true,
    "checkJs": true,
    "moduleDetection": "force",
    // `$lib` alias — mirrored in tsconfig.json (for the shadcn-svelte CLI)
    // and vite.config.ts (for the actual bundle). No `baseUrl`: TS 6
    // deprecates it and resolves relative `paths` against this file's
    // directory anyway.
    "paths": {
      "$lib": ["./src/ui"],
      "$lib/*": ["./src/ui/*"]
    },
    // Maximal strictness on top of the `strict: true` inherited from
    // @tsconfig/svelte (decisions/35-biome-and-maximal-strictness.md, card 91).
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // `noPropertyAccessFromIndexSignature` is the one flag decision 35 lists
    // that is NOT adopted. Measured on this tree (card 91): 357 errors across
    // 21 files, ~96% of them in the twelve JSON-parsing modules
    // (src/infra/mcp/results.ts, chrome-storage/chat-store.ts,
    // ollama/client.ts, openai/index.ts, ...). Every one of those sites reads
    // a `Record<string, unknown>` handed back by a local `isRecord()` guard
    // over untrusted JSON — a type with NO declared properties, where `x.foo`
    // and `x["foo"]` are equally unchecked, so the flag cannot surface a bug
    // there; it only rewrites notation. The two types in the repo where it
    // WOULD carry signal — ToolAnnotations (src/domain/tools/tool.ts:35) and
    // McpToolAnnotations (src/domain/tools/types.ts:118), which declare hints
    // alongside `[key: string]: unknown` — produce zero errors, because every
    // current access is to a declared member. So it buys nothing today at the
    // cost of 357 rewrites in precisely the files cards 92-95 are about to
    // migrate. Revisit if a mixed declared+index type ever gets read
    // dynamically.
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte"]
}
