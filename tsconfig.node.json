{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "noEmit": true,
    // Card 100: `vite.config.ts` imports `paraglide.options.mjs` — the one
    // definition of the Paraglide compiler options, shared with
    // `scripts/compile-i18n.mjs` (`postinstall`). It is `.mjs` because
    // postinstall runs on a bare `npm ci` with no TypeScript loader
    // guaranteed; `allowJs` is what lets this program see it. `checkJs` stays
    // off (it is not set anywhere in this file), so the module is TYPED by
    // its JSDoc annotation without being type-checked as if it were TS.
    "allowJs": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    // The same maximal-strictness set tsconfig.app.json adopts (card 91,
    // decisions/35), minus noPropertyAccessFromIndexSignature for the reason
    // documented there. This program is four build-config files, so the flags
    // cost nothing here — but they are what stops the build config drifting
    // looser than the code it builds.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true
  },
  "include": [
    "vite.config.ts",
    "manifest.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "paraglide.options.mjs"
  ]
}
